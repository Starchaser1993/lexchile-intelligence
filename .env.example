# Configuración del Servidor
PORT=3000
NODE_ENV=production

# Configuración de Google Cloud BigQuery
GOOGLE_PROJECT_ID=fallos-juridicos
GOOGLE_LOCATION=southamerica-west1

# Para despliegues en Vercel:
# Pega aquí el JSON completo de la Service Account de Google Cloud en una sola línea:
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"fallos-juridicos",...}

# O alternativamente, variables individuales de GCP:
# GCP_CLIENT_EMAIL=tu-servicio@fallos-juridicos.iam.gserviceaccount.com
# GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Para desarrollo local (opcional si usas la ruta por defecto):
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/tu/fallos-juridicos-key.json
